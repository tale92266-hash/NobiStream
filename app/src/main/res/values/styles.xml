<?xml version="1.0" encoding="utf-8"?>
<!--
  NobiStream v3 design system styles.
  Typography is native Roboto/system via Material3 text appearances —
  no bundled font (no APK bloat, no licensing risk).
  The app is dark-only: DayNight parent with identical day/night palettes.
-->
<resources>
    <style name="Theme.NobiStream" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/Widget.NobiStream.Dialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.NobiStream.BottomSheetDialog</item>
        <item name="android:windowAnimationStyle">@style/Theme.NobiStream.ActivityTransitions</item>
    </style>

    <!-- v8 launcher (splash) theme: first frame is the plain navy
         background with the app icon centred — never login UI. The
         LauncherActivity replaces this with its own splash layout. -->
    <style name="Theme.NobiStream.Launcher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Dialogs: 24dp radius, 24dp padding (layout), heading 20sp, body 14sp,
         actions 48dp. Applied app-wide via materialAlertDialogTheme. -->
    <style name="Widget.NobiStream.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/Shape.NobiStream.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NobiStream.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NobiStream.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.NobiStream.Button.Text</item>
    </style>

    <style name="Shape.NobiStream.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_dialog</item>
    </style>

    <!-- Bottom sheets: 24dp top radius, surface background, 220-280ms
         entrance/dismissal (platform default). Applied app-wide. -->
    <style name="Theme.NobiStream.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.NobiStream.BottomSheet</item>
    </style>

    <!-- v2: fade + slide between screens, applied app-wide. -->
    <style name="Theme.NobiStream.ActivityTransitions" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- ============ Buttons ============ -->

    <style name="Widget.NobiStream.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_small</item>
    </style>

    <style name="Widget.NobiStream.Button.Primary.Small" parent="Widget.NobiStream.Button.Primary">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Widget.NobiStream.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="cornerRadius">@dimen/corner_small</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.NobiStream.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.NobiStream.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_small</item>
        <item name="strokeColor">@color/error</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Widget.NobiStream.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/icon_button_size</item>
        <item name="android:minHeight">@dimen/icon_button_size</item>
    </style>

    <!-- ============ Cards ============ -->

    <style name="Widget.NobiStream.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">@dimen/elevation_2</item>
    </style>

    <style name="Widget.NobiStream.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">@dimen/elevation_0</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="Widget.NobiStream.Card.Flat" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="cardBackgroundColor">@color/surface_variant</item>
        <item name="cardElevation">@dimen/elevation_0</item>
    </style>

    <!-- ============ Filter chips (clear selected state, 32dp, horizontal scroll) ============ -->

    <style name="Widget.NobiStream.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipStartPadding">@dimen/chip_padding</item>
        <item name="chipEndPadding">@dimen/chip_padding</item>
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipStrokeWidth">@dimen/card_stroke_width</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="chipCornerRadius">@dimen/corner_full</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <!-- ============ Inputs ============ -->

    <style name="Widget.NobiStream.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/outline</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_small</item>
    </style>

    <style name="Widget.NobiStream.TextInputLayout.Search" parent="Widget.NobiStream.TextInputLayout">
        <item name="boxCornerRadiusTopStart">@dimen/corner_full</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_full</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_full</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_full</item>
        <item name="endIconMode">clear_text</item>
    </style>

    <!-- ============ Settings ============ -->

    <style name="Widget.NobiStream.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- ============ Bottom sheet (player options) ============ -->

    <style name="Widget.NobiStream.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/Shape.NobiStream.BottomSheet</item>
    </style>

    <style name="Shape.NobiStream.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/corner_sheet</item>
        <item name="cornerSizeTopRight">@dimen/corner_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Shape.NobiStream.ImageSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_small</item>
    </style>

    <style name="Shape.NobiStream.ImageMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_medium</item>
    </style>

    <!-- ============ Text appearances (native typography) ============ -->

    <style name="Text.NobiStream.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.NobiStream.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.NobiStream.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.NobiStream.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_card_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- v8: Subhead 16sp medium (hero title, group row title, portrait
         player title) and Action 13sp medium (See all / Clear / Resend). -->
    <style name="Text.NobiStream.Subhead" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_subhead</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.NobiStream.Action" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_action</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.NobiStream.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.NobiStream.FeaturedTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_featured_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.NobiStream.BrandTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_brand</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.NobiStream.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Text.NobiStream.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.NobiStream.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.NobiStream.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.NobiStream.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
