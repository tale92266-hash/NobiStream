<?xml version="1.0" encoding="utf-8"?>
<!--
  NobiStream v3 spacing / shape / size tokens — pixel spec (4dp grid).
  XS 4 / SM 8 / MD 12 / LG 16 / XL 20 / XXL 24 / XXXL 32.
  Screen margin 16dp (24dp on large screens, values-sw600dp).
  Section spacing 28dp, large section 40dp.
-->
<resources>
    <!-- Spacing (4dp scale) -->
    <dimen name="spacing_2">2dp</dimen>
    <dimen name="spacing_4">4dp</dimen>
    <dimen name="spacing_8">8dp</dimen>
    <dimen name="spacing_12">12dp</dimen>
