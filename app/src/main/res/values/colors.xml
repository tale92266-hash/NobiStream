<?xml version="1.0" encoding="utf-8"?>
<!--
  NobiStream design tokens — DAY (light) palette.
  v2.6.1: the day palette is LIGHT and the night palette
  (values-night/colors.xml) stays dark graphite. Before 2.6.1 both
  qualifiers were intentionally identical dark tokens ("dark-only by
  decision"), so AppCompatDelegate night-mode changes did NOTHING
  visible on the Views screens (Login, Continue All) — Light mode
  could never reach them. The token NAMES are unchanged; every
  screen references these names, never hardcoded hex. Light values
  mirror the Compose LightColorScheme (background #F6F8FC, surface
  #FFFFFF, card #EEF1F8, primary violet #5A45E6).
-->
<resources>
    <!-- Brand / accent -->
    <color name="primary">#5A45E6</color>
    <color name="primary_dark">#4738C0</color>
    <color name="primary_container">#E4E0FF</color>
    <color name="on_primary_container">#2A1F6E</color>
    <color name="accent">#5A45E6</color>

    <!-- Surfaces: background &lt; surface &lt; surface_variant &lt; surface_high -->
    <color name="background">#F6F8FC</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EEF1F8</color>
    <color name="surface_high">#E8ECF5</color>
    <color name="surface_container">#F0F3F9</color>

    <!-- Text -->
    <color name="text_primary">#151924</color>
    <color name="text_secondary">#535D73</color>
    <color name="on_surface_variant">#535D73</color>
    <color name="text_disabled">#9AA3B5</color>

    <!-- Lines -->
    <color name="divider">#DFE4EE</color>
    <color name="outline">#9AA3B5</color>
    <color name="outline_variant">#DFE4EE</color>

    <!-- Semantic -->
    <color name="success">#34C77B</color>
    <color name="warning">#F5A623</color>
    <color name="error">#E5484D</color>
    <color name="error_container">#FDE8E9</color>
    <color name="on_error">#FFFFFF</color>

    <!-- Video badges -->
    <color name="quality_badge">#FFB020</color>
    <color name="on_quality_badge">#000000</color>

    <!-- Playback progress -->
    <color name="progress_played">#5A45E6</color>
    <!-- v2.6.1: dark translucent track on a light background -->
    <color name="progress_track">#40000000</color>
    <color name="progress_buffered">#B9C0D0</color>

    <!-- Scrims -->
    <color name="scrim">#CC000000</color>
    <color name="scrim_light">#66000000</color>
    <color name="scrim_top">#99000000</color>
    <color name="scrim_bottom">#99000000</color>

    <!-- v2.6.1: light-mode CTAs are violet-filled with white text
         (a white fill on a light background would be invisible;
         dark mode keeps the white fill / dark text). -->
    <color name="cta_fill">#5A45E6</color>
    <color name="on_cta_fill">#FFFFFF</color>

    <!-- Filter chips: selected = accent with light text, unselected = quiet surface -->
    <color name="chip_selected_bg">#5A45E6</color>
    <color name="chip_selected_text">#FFFFFF</color>
    <color name="chip_unselected_bg">#EEF1F8</color>
    <color name="chip_unselected_text">#535D73</color>
    <color name="chip_unselected_stroke">#DFE4EE</color>

    <!-- Skeleton shimmer base -->
    <color name="skeleton">#E4E8F0</color>

    <!-- v8: dark translucent pills (quality / duration / cached badges) -->
    <color name="badge_dark_bg">#CC000000</color>
    <!-- v8: bottom-nav selected indicator — accent at 20% alpha -->
    <color name="nav_indicator">#335A45E6</color>
</resources>
