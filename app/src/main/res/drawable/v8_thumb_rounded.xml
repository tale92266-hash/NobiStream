<?xml version="1.0" encoding="utf-8"?>
<!-- v8 thumbnail backdrop + clip outline: 12dp rounded corners
     (corner_thumb token), so the image, badges and progress bar are
     all clipped to the same radius as the video card thumb. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/corner_thumb" />
</shape>
