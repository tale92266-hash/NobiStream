<?xml version="1.0" encoding="utf-8"?>
<!-- v9.1 #2: OTP box — filled surface box, 12dp corners; focused
     box gets the 2dp accent stroke so the current box is obvious. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <stroke
                android:width="2dp"
                android:color="@color/primary" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <stroke
                android:width="@dimen/card_stroke_width"
                android:color="@color/outline" />
            <corners android:radius="@dimen/corner_small" />
        </shape>
    </item>
</selector>
