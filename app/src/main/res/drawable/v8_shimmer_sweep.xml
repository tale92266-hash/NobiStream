<?xml version="1.0" encoding="utf-8"?>
<!-- v8 skeleton shimmer sweep: a diagonal translucent band that
     translates across the skeleton container (1200ms, spec §2F).
     The pulse animation is gone — motion is a sweep, not a blink. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:centerColor="#33FFFFFF"
        android:endColor="#00FFFFFF"
        android:startColor="#00FFFFFF"
        android:type="linear" />
</shape>
