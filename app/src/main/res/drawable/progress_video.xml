<?xml version="1.0" encoding="utf-8"?>
<!-- Horizontal progress bar: accent played portion on a dark track (used on thumbnails). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/progress_track" />
            <!-- v9.1 #7: 4dp bar, fully rounded ends (2dp radius). -->
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/progress_played" />
                <corners android:radius="2dp" />
            </shape>
        </clip>
    </item>
</layer-list>
