<?xml version="1.0" encoding="utf-8"?>
<!-- v8 §4.4 — 3-stop legibility scrim behind the player controls:
     top 60% black -> centre transparent -> bottom 60% black, so the
     title and the controls stay readable over bright frames. The
     centre stop is fully transparent so the video itself is never
     dimmed where nothing sits on top of it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="90"
        android:centerColor="#00000000"
        android:endColor="#99000000"
        android:startColor="#99000000"
        android:type="linear" />
</shape>
