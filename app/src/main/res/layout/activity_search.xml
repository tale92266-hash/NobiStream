<?xml version="1.0" encoding="utf-8"?>
<!-- v4 Search: toolbar, 56dp pill search field (20dp search icon,
     48dp clear action via TextInputLayout clear_text end icon), recent
     searches under the field, results in the SAME 2-column VideoCard
     grid as Channel Detail, shimmer skeleton while searching, and
     v3 EmptyState / ErrorState components for every state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- v8: Search is a top-level bottom-nav tab — no back button. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        app:title="@string/search_title"
        app:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/screen_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.NobiStream.TextInputLayout.Search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_field_height"
            android:hint="@string/search_hint"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEdit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- v8: "Paste Telegram link" chip — only when the field is
         empty and the clipboard holds a t.me link (see
         SearchActivity.updatePasteChip). Tap adds the link as a
         group via MainActivity. -->
    <com.google.android.material.chip.Chip
        android:id="@+id/pasteLinkChip"
        style="@style/Widget.NobiStream.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_8"
        android:checkable="false"
        android:text="@string/v8_paste_link"
        android:visibility="gone" />

    <!-- Recent searches, shown only while the query is empty. -->
    <LinearLayout
        android:id="@+id/recentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                style="@style/Text.NobiStream.SectionHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/search_recent" />

            <TextView
                android:id="@+id/recentClearButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="@dimen/spacing_12"
                android:paddingTop="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_12"
                android:paddingBottom="@dimen/spacing_8"
                android:text="@string/search_recent_clear"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_action" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <!-- v8 shimmer skeleton in the SAME grid as the real cards.
         The FrameLayout is the visibility toggle; the GridLayout
         columnCount is set from gridSpanCount() in code (1 on
         mobile — never hardcoded 2). Outer padding is the 16dp
         screen margin; item margins are the 12dp/16dp grid gaps
         (6dp/8dp half-gaps). -->
    <FrameLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <GridLayout
            android:id="@+id/skeletonGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <include
                layout="@layout/item_skeleton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="8dp" />

            <include
                layout="@layout/item_skeleton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="8dp" />

            <include
                layout="@layout/item_skeleton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="8dp" />

            <include
                layout="@layout/item_skeleton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginHorizontal="6dp"
                android:layout_marginVertical="8dp" />
        </GridLayout>

        <View
            android:id="@+id/shimmerSweep"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:background="@drawable/v8_shimmer_sweep"
            android:translationX="-160dp" />
    </FrameLayout>

    <!-- v9.1 #16: result count, above the grid ("12 results"). -->
    <TextView
        android:id="@+id/resultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/screen_margin"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_8"
        android:visibility="gone" />

    <com.nobi.nobistream.ui.components.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.nobi.nobistream.ui.components.ErrorStateView
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- v8 bottom navigation (Search is a top-level tab). -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
