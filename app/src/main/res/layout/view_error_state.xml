<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable error state (inflated by ErrorStateView): icon, title, body, retry action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_24">

    <ImageView
        android:id="@+id/errorIcon"
        android:layout_width="@dimen/icon_size_large"
        android:layout_height="@dimen/icon_size_large"
        android:src="@drawable/ic_error"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/errorTitle"
        style="@style/Text.NobiStream.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:gravity="center" />

    <TextView
        android:id="@+id/errorBody"
        style="@style/Text.NobiStream.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorRetry"
        style="@style/Widget.NobiStream.Button.Primary.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/common_retry" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorDismiss"
        style="@style/Widget.NobiStream.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/common_close"
        android:visibility="gone" />

</LinearLayout>
