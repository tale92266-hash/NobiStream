<?xml version="1.0" encoding="utf-8"?>
<!-- v9.9 Audio Settings sub-screen: ONE read-only info card — the
     audio formats that play on this phone (decoded in the app by the
     NextLib FFmpeg extension since v9.7) + the honest stereo-downmix
     note. No switches, no dropdowns: nothing is invented here.
     Own 56dp toolbar + back, NO bottom nav. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/settings_audio_title"
        app:titleTextAppearance="@style/Text.NobiStream.Title"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_24">

            <TextView
                style="@style/Text.NobiStream.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/settings_audio_supported_title" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                style="@style/Widget.NobiStream.Card.Outlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/settings_row_min_height"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_volume" />

                        <TextView
                            style="@style/Text.NobiStream.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_16"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/settings_audio_supported_title" />
                    </LinearLayout>

                    <!-- One row per format: name + "Decoded in the app". -->
                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Dolby Digital" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="Dolby Digital Plus" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="Dolby TrueHD" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="DTS" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="AAC" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="FLAC" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="Opus" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <TextView
                        style="@style/Text.NobiStream.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="MP3" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_4"
                        android:text="@string/settings_audio_decoded" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@color/divider" />

                    <TextView
                        style="@style/Text.NobiStream.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:text="@string/settings_audio_downmix" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
