<?xml version="1.0" encoding="utf-8"?>
<!-- v8 skeleton placeholder card: the SAME dimensions as the real
     boxless video card (16:9 thumb by ratio, same text lines, same
     0dp title/meta insets) — never a generic block. No card/box:
     the loaded card has no box either, so the skeleton must not
     either (zero layout shift). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/skeletonThumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/skeleton_bg"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skeletonTitle"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginTop="@dimen/spacing_8"
        android:background="@drawable/skeleton_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonThumb" />

    <View
        android:id="@+id/skeletonMeta"
        android:layout_width="120dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_12"
        android:background="@drawable/skeleton_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeletonTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
