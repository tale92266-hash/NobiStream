<?xml version="1.0" encoding="utf-8"?>
<!-- v8 group row (spec §4.2): NO card/box — a clean edge-to-edge list
     row. Left 56dp CIRCULAR avatar (ShapeableImageView, built-in
     CornerFull shape — no styles.xml change), title 16sp Subhead,
     subtitle 12sp ("N videos • Updated 12 Nov"), right chevron
     24dp #9AA8BC. 1dp inset divider (#24334A) starts after the
     avatar (16dp screen margin + 56dp avatar + 12dp gap = 84dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_12">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/groupPhoto"
            android:layout_width="@dimen/group_icon_size"
            android:layout_height="@dimen/group_icon_size"
            android:contentDescription="@string/home_title"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video_placeholder"
            app:shapeAppearance="@style/ShapeAppearance.Material3.CornerFull" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupTitle"
                style="@style/Text.NobiStream.Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/groupSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/groupChevron"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_marginStart="84dp"
        android:background="@color/divider" />
</LinearLayout>
