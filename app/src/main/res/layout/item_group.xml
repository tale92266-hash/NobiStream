<?xml version="1.0" encoding="utf-8"?>
<!-- v8 group row (spec §4.2): NO card/box — a clean edge-to-edge list
     row. Left 56dp CIRCULAR avatar (ShapeableImageView with the local
     Shape.NobiStream.Circle 50% shape), title 16sp Subhead,
     subtitle 12sp ("N videos • Updated 12 Nov"), right chevron
     24dp secondary. 1dp inset divider starts after the
     avatar (16dp screen margin + 56dp avatar + 12dp gap = 84dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_12"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_12">

        <!-- v9.1 #19: avatar stack — tonal letter circle underneath,
             photo on top when it loads, NEW dot top-right. -->
        <FrameLayout
            android:layout_width="@dimen/group_icon_size"
            android:layout_height="@dimen/group_icon_size"
            android:background="@drawable/bg_letter_avatar">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/groupPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/home_title"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/Shape.NobiStream.Circle" />

            <TextView
                android:id="@+id/groupLetter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:id="@+id/groupNewDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_new_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupTitle"
                style="@style/Text.NobiStream.Body"
                android:fontFamily="sans-serif-medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/groupSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/groupChevron"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:layout_marginStart="88dp"
        android:background="@color/divider" />
</LinearLayout>
