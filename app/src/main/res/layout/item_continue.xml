<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.NobiStream.Card"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_8"
    android:layout_marginTop="@dimen/spacing_4"
    android:layout_marginBottom="@dimen/spacing_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/continueThumb"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="@string/home_continue_watching"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video_placeholder" />

        <TextView
            android:id="@+id/continueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:padding="@dimen/spacing_8"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <ProgressBar
            android:id="@+id/continueProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_marginEnd="@dimen/spacing_8"
            android:layout_marginBottom="@dimen/spacing_8"
            android:max="100"
            android:progress="0" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
