<?xml version="1.0" encoding="utf-8"?>
<!-- v8 Home: bottom navigation (Home / Search / Library / Settings)
     + cleaned top bar (brand + Add Group + refresh only; Search and
     Settings moved to the bottom nav). Two tab containers share one
     FrameLayout: HOME (Hero Spotlight + Continue Watching row minus
     the hero item + Your Groups) and LIBRARY (chips + 1-column grid
     + footer spinner, no Load More button). The hero shows the most
     recent Continue Watching video; that video is EXCLUDED from the
     row below (Sam's v4 lesson: hero + row must never duplicate). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- App bar: 56dp, brand icon 28dp, brand text 20sp, Add Group
         button + refresh. Search and Settings live in the bottom nav. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/spacing_8">

        <ImageView
            android:layout_width="@dimen/icon_size_large"
            android:layout_height="@dimen/icon_size_large"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            style="@style/Text.NobiStream.BrandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addGroupButton"
            style="@style/Widget.NobiStream.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/home_add_group_short"
            app:icon="@drawable/ic_add" />

        <!-- v9.1 #6: refresh button + spinner share one 48dp frame —
             the spinner replaces the button INSIDE the frame, so the
             top bar never shifts when a refresh starts. -->
        <FrameLayout
            android:id="@+id/homeRefreshFrame"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size">

            <ImageButton
                android:id="@+id/homeRefreshButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_refresh"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/homeRefreshProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- HOME tab — pull-to-refresh (v9.1 #6). -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/homeSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- v9.1 #4: Home skeleton — shown while the groups
                     are still loading on a cold start. -->
                <!-- v9.2: a skeleton must never eat a tap — the
                     container, the grid and the sweep are all
                     explicitly non-clickable / non-focusable, so a
                     stuck skeleton can only ever be scrolled past,
                     never tapped into silence. -->
                <FrameLayout
                    android:id="@+id/homeSkeletonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone">

                    <GridLayout
                        android:id="@+id/homeSkeletonGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin" />

                    <View
                        android:id="@+id/homeShimmerSweep"
                        android:layout_width="160dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/v8_shimmer_sweep"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <!-- Hero Spotlight: the most recent Continue Watching
                     video. 16:9 thumb, scrim, title + meta over the
                     image, Resume pill bottom-left. This video is
                     excluded from the row below. -->
                <LinearLayout
                    android:id="@+id/heroSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/spacing_16"
                    android:paddingEnd="@dimen/screen_margin"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/heroCard"
                        style="@style/Widget.NobiStream.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToOutline="true"
                        app:cardCornerRadius="24dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/heroThumb"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:contentDescription="@string/home_continue_watching"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bg_thumb_placeholder"
                                app:layout_constraintDimensionRatio="16:9"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <View
                                android:id="@+id/heroScrim"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:background="@drawable/bg_hero_scrim"
                                app:layout_constraintBottom_toBottomOf="@id/heroThumb"
                                app:layout_constraintEnd_toEndOf="@id/heroThumb"
                                app:layout_constraintStart_toStartOf="@id/heroThumb"
                                app:layout_constraintTop_toTopOf="@id/heroThumb" />

                            <!-- v9.1 #9: hero shimmer — the dark sweep
                                 over the thumbnail until it loads. -->
                            <View
                                android:id="@+id/heroShimmer"
                                android:layout_width="160dp"
                                android:layout_height="0dp"
                                android:background="@drawable/v8_shimmer_sweep"
                                android:visibility="gone"
                                app:layout_constraintBottom_toBottomOf="@id/heroThumb"
                                app:layout_constraintStart_toStartOf="@id/heroThumb"
                                app:layout_constraintTop_toTopOf="@id/heroThumb" />

                            <!-- v9.1 #9: duration + quality pills on
                                 the hero thumb (top corners). The
                                 duration pill clears the More button
                                 (72dp end margin). -->
                            <TextView
                                android:id="@+id/heroQuality"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_16"
                                android:layout_marginTop="@dimen/spacing_16"
                                android:background="@drawable/v8_badge_dark"
                                android:paddingStart="@dimen/spacing_8"
                                android:paddingTop="@dimen/spacing_4"
                                android:paddingEnd="@dimen/spacing_8"
                                android:paddingBottom="@dimen/spacing_4"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_badge"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/heroThumb" />

                            <TextView
                                android:id="@+id/heroDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_16"
                                android:layout_marginEnd="72dp"
                                android:background="@drawable/v8_badge_dark"
                                android:paddingStart="@dimen/spacing_8"
                                android:paddingTop="@dimen/spacing_4"
                                android:paddingEnd="@dimen/spacing_8"
                                android:paddingBottom="@dimen/spacing_4"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_badge"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/heroThumb" />

                            <!-- v9.1 #9: hero overflow (View copies /
                                 Open channel), top-right corner. -->
                            <ImageButton
                                android:id="@+id/heroMore"
                                android:layout_width="@dimen/icon_button_size"
                                android:layout_height="@dimen/icon_button_size"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:layout_marginEnd="@dimen/spacing_8"
                                android:background="@drawable/bg_gesture_pill"
                                android:contentDescription="@string/hero_menu_copies"
                                android:src="@drawable/ic_more_vert"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/heroThumb"
                                app:tint="#E3E3E3" />

                            <TextView
                                android:id="@+id/heroTitle"
                                style="@style/Text.NobiStream.Subhead"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_16"
                                android:layout_marginEnd="@dimen/spacing_16"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/text_primary"
                                app:layout_constraintBottom_toTopOf="@id/heroMeta"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/heroMeta"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_16"
                                android:layout_marginEnd="@dimen/spacing_16"
                                android:layout_marginBottom="@dimen/spacing_12"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#E3E3E3"
                                android:textSize="@dimen/text_caption"
                                app:layout_constraintBottom_toTopOf="@id/heroResumeButton"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/heroResumeButton"
                                style="@style/Widget.NobiStream.Button.Primary.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="@dimen/spacing_16"
                                android:layout_marginBottom="@dimen/spacing_16"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_play"
                                app:layout_constraintBottom_toBottomOf="@id/heroThumb"
                                app:layout_constraintStart_toStartOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Continue Watching header: title + "See all" (13sp medium). -->
                <LinearLayout
                    android:id="@+id/continueHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_8"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/continueTitle"
                        style="@style/Text.NobiStream.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_continue_watching" />

                    <TextView
                        android:id="@+id/continueSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/spacing_12"
                        android:paddingTop="@dimen/spacing_8"
                        android:paddingEnd="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_8"
                        android:text="@string/home_see_all"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_action" />
                </LinearLayout>

                <!-- Continue Watching row: every in-progress episode
                     EXCEPT the hero item. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/continueRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_8"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Your Groups header. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin">

                    <TextView
                        style="@style/Text.NobiStream.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_groups" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/groupsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="@dimen/spacing_8"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- v9: designed quiet state when the group list is
                     short (1–2 groups) — tonal icon in a 96dp circle
                     + one line + Add Group button, instead of the
                     blank dark space below the single group. -->
                <LinearLayout
                    android:id="@+id/homeQuietState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/spacing_24"
                    android:paddingBottom="@dimen/spacing_24"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/v8_state_circle">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_add"
                            android:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        style="@style/Text.NobiStream.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:gravity="center"
                        android:text="@string/home_quiet_title" />

                    <TextView
                        style="@style/Text.NobiStream.BodySecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:gravity="center"
                        android:maxWidth="280dp"
                        android:text="@string/home_quiet_body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/homeQuietAddButton"
                        style="@style/Widget.NobiStream.Button.Primary.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height_small"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="@string/home_add_group_short" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- LIBRARY tab — pull-to-refresh (v9.1 #6). -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/librarySwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/libraryContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- v9.1 #4: Library skeleton — shown while the first
                     library page is still loading. -->
                <!-- v9.2: same non-clickable guarantee as the Home
                     skeleton (see homeSkeletonContainer). -->
                <FrameLayout
                    android:id="@+id/librarySkeletonContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone">

                    <GridLayout
                        android:id="@+id/librarySkeletonGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin" />

                    <View
                        android:id="@+id/libraryShimmerSweep"
                        android:layout_width="160dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/v8_shimmer_sweep"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/libraryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/spacing_8"
                    android:visibility="gone">

                    <TextView
                        style="@style/Text.NobiStream.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_library" />

                    <ImageButton
                        android:id="@+id/librarySortButton"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/home_sort"
                        android:src="@drawable/ic_sort" />
                </LinearLayout>

                <!-- v9.1 #35: chip-row edge fade — the row fades out
                     at the right edge instead of clipping hard. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <HorizontalScrollView
                    android:id="@+id/libraryFilterScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <!-- v5: same Smart toggle as Channel Detail — beside
                         the quality ChipGroup, never inside it (see
                         activity_channel.xml). -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingTop="@dimen/spacing_8"
                        android:paddingEnd="@dimen/screen_margin">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/libraryFilterChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/chip_gap"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/libChipAll"
                                style="@style/Widget.NobiStream.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:checked="true"
                                android:text="@string/channel_filter_all" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/libChip480"
                                style="@style/Widget.NobiStream.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="480p" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/libChip720"
                                style="@style/Widget.NobiStream.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="720p" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/libChip1080"
                                style="@style/Widget.NobiStream.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="1080p" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/libChip4k"
                                style="@style/Widget.NobiStream.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="4K" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/libChipSmart"
                            style="@style/Widget.NobiStream.Chip.Smart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/chip_gap"
                            android:checkable="true"
                            android:checked="true"
                            android:text="@string/channel_filter_smart" />
                    </LinearLayout>
                </HorizontalScrollView>

                    <View
                        android:id="@+id/libraryChipsFade"
                        android:layout_width="16dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:background="@drawable/fade_edge_right"
                        android:clickable="false"
                        android:focusable="false" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/libraryRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingBottom="@dimen/spacing_8" />

                <!-- v8: no Load More button — the footer spinner is the
                     only loading indicator; scrolling near the bottom
                     loads the next page. -->
                <LinearLayout
                    android:id="@+id/libraryLoadMoreFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_12"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_8"
                        android:text="@string/channel_loading_more"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <com.nobi.nobistream.ui.components.EmptyStateView
                    android:id="@+id/libraryEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/spacing_24"
                    android:paddingBottom="@dimen/spacing_24"
                    android:visibility="gone" />

                <com.nobi.nobistream.ui.components.ErrorStateView
                    android:id="@+id/libraryErrorState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/spacing_24"
                    android:paddingBottom="@dimen/spacing_24"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Shown when no groups exist yet (either tab). -->
        <!-- v9.2: the full-screen empty state is the topmost child
             of this container — explicitly non-clickable /
             non-focusable, so it can never swallow taps meant for
             the content beneath it (its own action button stays
             clickable: clickable is per-view, not inherited). -->
        <com.nobi.nobistream.ui.components.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
