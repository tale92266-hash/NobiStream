<?xml version="1.0" encoding="utf-8"?>
<!-- v3 player: fullscreen video only. All controls live ON the video in the
     custom exo_player_control_view.xml. The buffering overlay makes the
     buffering state visible (spinner + %); the lock overlay is the only
     thing tappable while controls are locked. The error overlay (Retry /
     Close) replaces the old toast-only playback failure. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:show_buffering="never"
        app:use_controller="true" />

    <!-- Buffering overlay: loader + text + downloaded %. Kept from v2 —
         it is what tells buffering apart from a stuck frame. -->
    <LinearLayout
        android:id="@+id/bufferingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gesture_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="@dimen/player_buffering_size"
            android:layout_height="@dimen/player_buffering_size"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/player_buffering"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/bufferingPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <!-- v6 Rule 2: small offline line under the spinner, shown only
             after 10s of continuous stall (Handler timer in
             PlayerActivity). Never a Retry button — a stall retries
             in the background on its own. -->
        <TextView
            android:id="@+id/bufferingOfflineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/player_offline_retrying"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Gesture feedback pill: icon + text (brightness / volume / seek). -->
    <LinearLayout
        android:id="@+id/gestureFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gesture_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/feedbackIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_brightness" />

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- Playback error state: what happened + Retry / Close. -->
    <com.nobi.nobistream.ui.components.ErrorStateView
        android:id="@+id/playerError"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Lock overlay: the only tappable thing while locked. -->
    <ImageButton
        android:id="@+id/lockOverlayButton"
        android:layout_width="@dimen/player_lock_size"
        android:layout_height="@dimen/player_lock_size"
        android:background="@drawable/bg_gesture_pill"
        android:contentDescription="@string/player_unlock"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
