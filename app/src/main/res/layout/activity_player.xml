<?xml version="1.0" encoding="utf-8"?>
<!-- v2 player: fullscreen video only. All controls live ON the video in the
     custom exo_player_control_view.xml. The buffering overlay makes the
     buffering state visible (spinner + %); the lock overlay is the only
     thing tappable while controls are locked. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:show_buffering="never"
        app:use_controller="true" />

    <!-- Buffering overlay: big loader + text + downloaded %. -->
    <LinearLayout
        android:id="@+id/bufferingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/player_buffering"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/bufferingPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Gesture feedback pill: icon + text (brightness / volume / seek). -->
    <LinearLayout
        android:id="@+id/gestureFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/feedbackIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_brightness" />

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- Lock overlay: the only tappable thing while locked. -->
    <ImageButton
        android:id="@+id/lockOverlayButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@color/scrim"
        android:contentDescription="@string/player_unlock"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
