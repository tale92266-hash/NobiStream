<?xml version="1.0" encoding="utf-8"?>
<!-- v3 player: fullscreen video only. All controls live ON the video in the
     custom exo_player_control_view.xml. The buffering overlay makes the
     buffering state visible (spinner + %); the lock overlay is the only
     thing tappable while controls are locked. The error overlay (Retry /
     Close) replaces the old toast-only playback failure.
     v8 (§4.4): portrait shows a 16:9 PlayerView on top + a details panel
     below (title / meta / action pills); landscape is fullscreen with the
     panel gone. The Up Next countdown card, hold-to-2x pill, seekbar
     preview pill, double-tap ripple/pill and "Tap to unlock" pill are
     floating overlays owned by PlayerActivity. All pre-v8 ids are kept. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/detailsPanel"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:show_buffering="never"
        app:use_controller="true" />

    <!-- v8 §4.4: portrait details panel below the 16:9 player. GONE in
         landscape (PlayerActivity switches the PlayerView bottom
         constraint to the parent and hides this). -->
    <LinearLayout
        android:id="@+id/detailsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerView">

        <TextView
            android:id="@+id/detailsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subhead" />

        <TextView
            android:id="@+id/detailsMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:orientation="horizontal">

            <!-- v9.1 #14: real M3 chips (not TextViews with a pill
                 background) — same look, real touch ripple, real
                 chip icons. checkable=false: these are actions, not
                 toggles. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/detailsSubtitles"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/player_subtitles"
                android:textSize="@dimen/text_action"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_closed_caption" />

            <com.google.android.material.chip.Chip
                android:id="@+id/detailsSpeed"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:checkable="false"
                android:text="1.0x"
                android:textSize="@dimen/text_action"
                app:chipIcon="@drawable/ic_speed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/detailsAspect"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:checkable="false"
                android:text="Fit"
                android:textSize="@dimen/text_action"
                app:chipIcon="@drawable/ic_aspect_ratio" />

            <com.google.android.material.chip.Chip
                android:id="@+id/detailsCopies"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:checkable="false"
                android:textSize="@dimen/text_action"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Buffering overlay: loader + text + "Xs ahead". v9.1 #17:
         NO pill background any more — the text sits on the video
         with a shadow, so the overlay reads as a status, not a card. -->
    <LinearLayout
        android:id="@+id/bufferingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="@dimen/player_buffering_size"
            android:layout_height="@dimen/player_buffering_size"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/player_buffering"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/bufferingPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <!-- v6 Rule 2: small offline line under the spinner, shown only
             after 10s of continuous stall (Handler timer in
             PlayerActivity). Never a Retry button — a stall retries
             in the background on its own. -->
        <TextView
            android:id="@+id/bufferingOfflineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/player_offline_retrying"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Gesture feedback pill: icon + text (brightness / volume / seek). -->
    <LinearLayout
        android:id="@+id/gestureFeedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gesture_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/feedbackIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_brightness" />

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- v8 §4.4: double-tap seek feedback — a radial ripple + an
         animated "-10s / +10s" pill on the tapped half of the video.
         Both are centred on the PlayerView; PlayerActivity moves them
         left/right with horizontalBias (0.25 / 0.75). -->
    <View
        android:id="@+id/doubleTapRipple"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/player_double_tap_ripple"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/playerView" />

    <LinearLayout
        android:id="@+id/doubleTapPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gesture_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_16"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingBottom="@dimen/spacing_8"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.25"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/playerView">

        <ImageView
            android:id="@+id/doubleTapPillIcon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_forward_10" />

        <TextView
            android:id="@+id/doubleTapPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="+10s"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <!-- v8 §4.4: hold-to-2x pill, top-center while the finger is held. -->
    <TextView
        android:id="@+id/holdSpeedPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:background="@drawable/bg_gesture_pill"
        android:paddingStart="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_8"
        android:text="@string/player_hold_2x"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- v8 §4.4: seekbar floating preview — target timestamp + delta vs
         the scrub start, floating above the thumb while scrubbing.
         PlayerActivity slides it horizontally (translationX) to track
         the thumb; vertically it sits above the seekbar. -->
    <TextView
        android:id="@+id/seekPreviewPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_gesture_pill"
        android:paddingStart="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_8"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_action"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- v8 §4.4: Up Next countdown card — floating bottom-right of the
         video when an episode ends and a next one exists. -->
    <LinearLayout
        android:id="@+id/upNextCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_16"
        android:background="@drawable/player_up_next_card"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_12"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/playerView"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/upNextThumb"
            android:layout_width="96dp"
            android:layout_height="54dp"
            android:background="@drawable/player_up_next_thumb_bg"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video_placeholder" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:orientation="vertical">

            <TextView
                android:id="@+id/upNextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:maxWidth="220dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/upNextCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <!-- v9.1 #5: 48dp touch targets (they were ~29dp). -->
                <TextView
                    android:id="@+id/upNextCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_16"
                    android:paddingBottom="@dimen/spacing_8"
                    android:text="@string/player_up_next_cancel"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_action" />

                <TextView
                    android:id="@+id/upNextPlayNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_16"
                    android:paddingBottom="@dimen/spacing_8"
                    android:text="@string/player_up_next_play_now"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_action"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upNextPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingTop="@dimen/spacing_8"
                    android:paddingEnd="@dimen/spacing_16"
                    android:paddingBottom="@dimen/spacing_8"
                    android:text="@string/player_up_next_play"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_action"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Playback error state: what happened + Retry / Close. -->
    <com.nobi.nobistream.ui.components.ErrorStateView
        android:id="@+id/playerError"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- v9.6 lock (Sam 2026-11-18): the centre pill is GONE — the
         ONLY unlock control is this single button at the top-right
         corner of the video (same corner as v9.1/v9.4). Visible only
         while locked; the lock button in the controller's bottom row
         (bottom-right) locks. The button and the seekbar show/hide
         TOGETHER on the 3s timer (see showLockCluster /
         hideLockCluster in PlayerActivity). -->
    <ImageButton
        android:id="@+id/lockCornerButton"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:background="@drawable/bg_gesture_pill"
        android:contentDescription="@string/player_unlock"
        android:elevation="8dp"
        android:src="@drawable/ic_lock_open"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintTop_toTopOf="@id/playerView" />

    <!-- v9.6 Item B: persistent notice when the current video's
         audio cannot play on this device (unsupported codec — the
         track is never selected, so the video plays silently with no
         error) or the file has no audio track at all. Outside the
         controller so it stays visible after the controls auto-hide;
         PlayerActivity drives it from onTracksChanged. Single line,
         just below the top bar, so it never covers the centre
         transport in portrait. -->
    <TextView
        android:id="@+id/audioNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_gesture_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="@dimen/spacing_12"
        android:paddingTop="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_8"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_caption"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/playerView"
        app:layout_constraintStart_toStartOf="@id/playerView"
        app:layout_constraintTop_toTopOf="@id/playerView" />

</androidx.constraintlayout.widget.ConstraintLayout>
