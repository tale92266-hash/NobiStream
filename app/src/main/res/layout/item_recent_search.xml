<?xml version="1.0" encoding="utf-8"?>
<!-- v4 recent-search row: 48dp touch target, 20dp history icon,
     query text 14sp. Tap runs the search again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/spacing_8"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/spacing_8">

    <ImageView
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:contentDescription="@string/search_recent"
        android:src="@drawable/ic_history" />

    <TextView
        android:id="@+id/recentQuery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body" />

    <!-- v8: per-row delete (48dp touch target, 24dp icon inside). -->
    <ImageView
        android:id="@+id/recentDelete"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/v8_delete_recent_search"
        android:focusable="true"
        android:padding="@dimen/spacing_12"
        android:src="@drawable/ic_close"
        android:tint="@color/text_secondary" />

</LinearLayout>
