<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Media3 controller (v3, Netflix-style polish v4). PlayerView only
  manages the ids it knows: exo_position / exo_duration / exo_progress
  (DefaultTimeBar, buffered progress + time labels). Every other button
  has a custom id and is wired by PlayerActivity, so ALL icons are the
  Material Symbols drawables (24dp, #E3E3E3) — no Media3 stock icons.

  Hierarchy (Netflix-style, clean + minimal): top bar (back, title,
  settings) / centre transport (Prev, -10s, big Play/Pause, +10s, Next)
  / time labels + seek bar / bottom row (fullscreen, aspect, PiP, lock,
  episode counter, speed). Speed + autoplay + aspect also live in the
  options bottom sheet; the speed label here is a shortcut into it.

  The root has an id (playerControllerRoot) so PlayerActivity can fade
  it in/out — visibility is driven ONLY by its isControlsVisible
  boolean, never by PlayerView's internal state.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerControllerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_controller_scrim">

    <!-- Top bar: close, title, settings. 48dp buttons + 8dp top margin = ~64dp top area. -->
    <ImageButton
        android:id="@+id/ctrlBack"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginTop="@dimen/spacing_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_close"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ctrlTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ctrlBack"
        app:layout_constraintEnd_toStartOf="@id/ctrlOptions"
        app:layout_constraintStart_toEndOf="@id/ctrlBack"
        app:layout_constraintTop_toTopOf="@id/ctrlBack" />

    <ImageButton
        android:id="@+id/ctrlOptions"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginTop="@dimen/spacing_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_options"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center controls: 16dp gaps between neighbours (8dp margins each
         side), play/pause 64dp touch with ~48dp icon (8dp padding),
         secondary 48dp touch with 32dp icons (8dp padding). -->
    <ImageButton
        android:id="@+id/ctrlPrev"
        android:layout_width="@dimen/player_control_size"
        android:layout_height="@dimen/player_control_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_previous"
        android:padding="@dimen/spacing_8"
        android:src="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlRew"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlRew"
        android:layout_width="@dimen/player_control_size"
        android:layout_height="@dimen/player_control_size"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_rewind_10"
        android:padding="@dimen/spacing_8"
        android:src="@drawable/ic_replay_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlPlayPause"
        app:layout_constraintStart_toEndOf="@id/ctrlPrev"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlPlayPause"
        android:layout_width="@dimen/player_play_size"
        android:layout_height="@dimen/player_play_size"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_play_pause"
        android:padding="@dimen/spacing_8"
        android:src="@drawable/ic_pause"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlFfwd"
        app:layout_constraintStart_toEndOf="@id/ctrlRew"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlFfwd"
        android:layout_width="@dimen/player_control_size"
        android:layout_height="@dimen/player_control_size"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_forward_10"
        android:padding="@dimen/spacing_8"
        android:src="@drawable/ic_forward_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlNext"
        app:layout_constraintStart_toEndOf="@id/ctrlPlayPause"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlNext"
        android:layout_width="@dimen/player_control_size"
        android:layout_height="@dimen/player_control_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_next"
        android:padding="@dimen/spacing_8"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ctrlFfwd"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom: time + seek bar. Track 3dp, touch height 24dp, thumb 12dp,
         16dp side margins, time text 12sp. -->
    <TextView
        android:id="@id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="@dimen/player_timebar_height"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        app:bar_height="3dp"
        app:buffered_color="@color/progress_buffered"
        app:played_color="@color/primary"
        app:scrubber_color="@color/primary"
        app:scrubber_enabled_size="12dp"
        app:touch_target_height="24dp"
        app:unplayed_color="@color/outline"
        app:layout_constraintBottom_toTopOf="@id/ctrlBottomRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom row: fullscreen, aspect, PiP, lock, episode counter, speed -->
    <LinearLayout
        android:id="@+id/ctrlBottomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/ctrlFullscreen"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_fullscreen"
            android:src="@drawable/ic_fullscreen_exit" />

        <ImageButton
            android:id="@+id/ctrlAspect"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_aspect_ratio"
            android:src="@drawable/ic_aspect_ratio" />

        <ImageButton
            android:id="@+id/ctrlPip"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_pip"
            android:src="@drawable/ic_pip" />

        <ImageButton
            android:id="@+id/ctrlLock"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_lock"
            android:src="@drawable/ic_lock_open" />

        <!-- v6 Rule 6: CC button. GONE unless a subtitle sidecar was
             found for this video (PlayerActivity drives visibility).
             Tinted #229ED9 while subtitles are ON, plain #E3E3E3 off. -->
        <ImageButton
            android:id="@+id/ctrlSubtitles"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_subtitles"
            android:src="@drawable/ic_closed_caption"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ctrlCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_8"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <TextView
            android:id="@+id/ctrlSpeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/spacing_8"
            android:text="1.0x"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
