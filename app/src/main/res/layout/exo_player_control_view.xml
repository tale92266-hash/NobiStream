<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Media3 controller (v2). PlayerView only manages the ids it knows:
  exo_position / exo_duration / exo_progress (DefaultTimeBar). Every other
  button has a custom id and is wired by PlayerActivity, so ALL icons are
  the Material Symbols drawables (24dp, #E3E3E3) — no Media3 stock icons.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_controller_scrim">

    <!-- Top bar: close, title, settings -->
    <ImageButton
        android:id="@+id/ctrlBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_close"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ctrlTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ctrlBack"
        app:layout_constraintEnd_toStartOf="@id/ctrlOptions"
        app:layout_constraintStart_toEndOf="@id/ctrlBack"
        app:layout_constraintTop_toTopOf="@id/ctrlBack" />

    <ImageButton
        android:id="@+id/ctrlOptions"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_options"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center controls -->
    <ImageButton
        android:id="@+id/ctrlPrev"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_previous"
        android:src="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlRew"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlRew"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_rewind_10"
        android:src="@drawable/ic_replay_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlPlayPause"
        app:layout_constraintStart_toEndOf="@id/ctrlPrev"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlPlayPause"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_play_pause"
        android:src="@drawable/ic_pause"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlFfwd"
        app:layout_constraintStart_toEndOf="@id/ctrlRew"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlFfwd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_forward_10"
        android:src="@drawable/ic_forward_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ctrlNext"
        app:layout_constraintStart_toEndOf="@id/ctrlPlayPause"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ctrlNext"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_next"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ctrlFfwd"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom: time + seek bar -->
    <TextView
        android:id="@id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        app:buffered_color="@color/text_disabled"
        app:played_color="@color/primary"
        app:scrubber_color="@color/primary"
        app:unplayed_color="@color/outline"
        app:layout_constraintBottom_toTopOf="@id/ctrlBottomRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom row: fullscreen, aspect, PiP, lock -->
    <LinearLayout
        android:id="@+id/ctrlBottomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/ctrlFullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_fullscreen"
            android:src="@drawable/ic_fullscreen_exit" />

        <ImageButton
            android:id="@+id/ctrlAspect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_aspect_ratio"
            android:src="@drawable/ic_aspect_ratio" />

        <ImageButton
            android:id="@+id/ctrlPip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_pip"
            android:src="@drawable/ic_pip" />

        <ImageButton
            android:id="@+id/ctrlLock"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_lock"
            android:src="@drawable/ic_lock_open" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ctrlSpeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_8"
            android:text="1.0x"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
