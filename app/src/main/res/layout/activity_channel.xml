<?xml version="1.0" encoding="utf-8"?>
<!-- v3 Channel: toolbar, redesigned filter chips (clear selected state,
     32dp, horizontal scroll), pill search field + icon-only sort/refresh,
     skeleton while loading, ErrorState on first-page failure. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/background"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/text_primary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <!-- v5: the Smart chip sits BESIDE the quality ChipGroup, not
             inside it — it is an independent on/off toggle, and the
             ChipGroup's singleSelection would otherwise uncheck the
             quality chip when Smart is toggled. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_8"
            android:paddingEnd="@dimen/screen_margin">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/chip_gap"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/channel_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip480"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="480p" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip720"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="720p" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip1080"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="1080p" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip4k"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="4K" />
        </com.google.android.material.chip.ChipGroup>

            <!-- v5 Smart Filter toggle (default ON). One episode, one
                 card, in its best quality. Independent of the quality
                 chips: dedup runs first, the quality chip then filters
                 the deduped list. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipSmart"
                style="@style/Widget.NobiStream.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chip_gap"
                android:checkable="true"
                android:checked="true"
                android:text="@string/channel_filter_smart" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            style="@style/Widget.NobiStream.TextInputLayout.Search"
            android:layout_width="0dp"
            android:layout_height="@dimen/search_field_height"
            android:layout_weight="1"
            android:hint="@string/channel_search_hint"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEdit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/sortButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/channel_sort_newest"
            android:src="@drawable/ic_sort" />

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/channel_refresh"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- Shimmer skeleton in the SAME 2-column grid as the real cards. -->
    <GridLayout
        android:id="@+id/skeletonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <include
            layout="@layout/item_skeleton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="10dp" />

        <include
            layout="@layout/item_skeleton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="10dp" />

        <include
            layout="@layout/item_skeleton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="10dp" />

        <include
            layout="@layout/item_skeleton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="10dp" />
    </GridLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/videosRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_8" />

    <!-- Loading-more footer while later pages load. -->
    <LinearLayout
        android:id="@+id/loadMoreFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_12"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="@string/channel_loading_more"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- v4 explicit Load more button (48dp, Secondary): always visible
         while more videos may exist; disabled + loading label mid-load. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/loadMoreButton"
        style="@style/Widget.NobiStream.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_small"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/spacing_8"
        android:text="@string/channel_load_more"
        android:visibility="gone" />

    <com.nobi.nobistream.ui.components.EmptyStateView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.nobi.nobistream.ui.components.ErrorStateView
        android:id="@+id/errorState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
