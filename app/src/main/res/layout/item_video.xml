<?xml version="1.0" encoding="utf-8"?>
<!--
  v8 video card (shared by Channel / Search / Library feeds — one style,
  never a second variant). Boxless: NO MaterialCardView, no elevation,
  no stroke. 16:9 thumbnail, 12dp corners PROPERLY CLIPPED — the
  thumb FrameLayout carries the 12dp rounded background and
  clipToOutline, so image, badges and progress bar all stay inside
  the radius (the old corner_thumb token was defined but never
  applied — that was the square-corners bug).
  Badges are dark pills (v8_badge_dark, white bold 11sp): quality +
  watched share a bottom-left row (never overlapping), duration sits
  bottom-right, copies top-right, cached (fully downloaded) top-left.
  Title 14sp medium max 2 lines; meta 12sp. Progress is a 3dp bar on
  the thumbnail's bottom edge with the visible progress_track.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/thumbFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/v8_thumb_rounded"
        android:clipToOutline="true"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/videoThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/home_continue_watching"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_thumb_placeholder" />

        <!-- Cached: fully downloaded locally (top-left). -->
        <LinearLayout
            android:id="@+id/cachedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/spacing_8"
            android:background="@drawable/v8_badge_dark"
            android:gravity="center"
            android:padding="@dimen/spacing_4"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/v8_cached"
                android:src="@drawable/ic_check"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- v5 Smart Filter: "N copies" badge — top-right, so it
             never collides with the cached badge (top-left) or the
             duration (bottom-right). Tappable: opens the copies picker. -->
        <TextView
            android:id="@+id/copiesBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/spacing_8"
            android:background="@drawable/v8_badge_dark"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/spacing_8"
            android:paddingTop="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_8"
            android:paddingBottom="@dimen/spacing_4"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Bottom-left row: quality pill first, watched AFTER it,
             so the two can never overlap. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/spacing_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/v8_badge_dark"
                android:paddingStart="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_4"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/watchedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:background="@drawable/v8_badge_dark"
                android:paddingStart="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_4"
                android:text="@string/common_watched"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/durationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/spacing_8"
            android:background="@drawable/v8_badge_dark"
            android:paddingStart="@dimen/spacing_8"
            android:paddingTop="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_8"
            android:paddingBottom="@dimen/spacing_4"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold" />

        <!-- Resume progress, integrated into the thumbnail's bottom edge. -->
        <ProgressBar
            android:id="@+id/videoProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_bar_height"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_video"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/videoTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/thumbFrame" />

    <TextView
        android:id="@+id/videoMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_12"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
