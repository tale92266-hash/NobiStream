<?xml version="1.0" encoding="utf-8"?>
<!-- v3 Add Channel bottom sheet: 24dp radius, 20dp padding, 32x4dp handle,
     heading 20sp, input 56dp, primary button 52dp. Closes only on success
     or explicit Cancel. Validation + loading + duplicate-add guard live in
     MainActivity; the Add button disables while adding (no double submit). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_20"
    android:paddingTop="@dimen/spacing_12"
    android:paddingEnd="@dimen/spacing_20"
    android:paddingBottom="@dimen/spacing_24">

    <View
        android:layout_width="@dimen/bottom_sheet_handle_width"
        android:layout_height="@dimen/bottom_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <TextView
        style="@style/Text.NobiStream.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/home_add_group" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/addChannelInputLayout"
        style="@style/Widget.NobiStream.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:hint="@string/home_add_link_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/addChannelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:minHeight="56dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/home_add_link_helper"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <ProgressBar
        android:id="@+id/addChannelLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_16"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addChannelButton"
        style="@style/Widget.NobiStream.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/home_add" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addChannelCancelButton"
        style="@style/Widget.NobiStream.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/home_cancel" />

</LinearLayout>
