<?xml version="1.0" encoding="utf-8"?>
<!-- v9.1 #35: Smart toggle chip background — ON is transparent
     (an outline toggle, never filled accent), OFF is the quiet surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@android:color/transparent" android:state_checked="true" />
    <item android:color="@color/chip_unselected_bg" />
</selector>
