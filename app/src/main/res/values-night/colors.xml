<?xml version="1.0" encoding="utf-8"?>
<!--
  NobiStream v3 design tokens — dark-first streaming theme.
  ONE accent (#229ED9, Telegram blue). No purple, no neon, no gradients.
  The night palette (values-night/colors.xml) is intentionally identical:
  this app is dark-only by decision, so both qualifiers resolve to the
  same tokens. All screens reference these names, never hardcoded hex.
-->
<resources>
    <!-- Brand / accent -->
    <color name="primary">#229ED9</color>
    <color name="primary_dark">#1B7FB8</color>
    <color name="primary_container">#12344A</color>
    <color name="on_primary_container">#BFE3F5</color>
    <color name="accent">#229ED9</color>

    <!-- Surfaces: background &lt; surface &lt; surface_variant &lt; surface_high -->
    <color name="background">#0B1220</color>
    <color name="surface">#131C2E</color>
    <color name="surface_variant">#1B2740</color>
    <color name="surface_high">#22304D</color>
    <color name="surface_container">#16223A</color>

    <!-- Text -->
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#9AA8BC</color>
    <color name="on_surface_variant">#C4D0E0</color>
    <color name="text_disabled">#5B6B80</color>

    <!-- Lines -->
    <color name="divider">#24334A</color>
    <color name="outline">#2E3D57</color>
    <color name="outline_variant">#22314A</color>

    <!-- Semantic -->
    <color name="success">#34C77B</color>
    <color name="warning">#F5A623</color>
    <color name="error">#E5484D</color>
    <color name="error_container">#3A1D22</color>
    <color name="on_error">#FFFFFF</color>

    <!-- Video badges -->
    <color name="quality_badge">#FFB020</color>
    <color name="on_quality_badge">#000000</color>

    <!-- Playback progress -->
    <color name="progress_played">#229ED9</color>
    <color name="progress_track">#4DFFFFFF</color>
    <color name="progress_buffered">#5B6B80</color>

    <!-- Scrims -->
    <color name="scrim">#CC000000</color>
    <color name="scrim_light">#66000000</color>
    <color name="scrim_top">#99000000</color>
    <color name="scrim_bottom">#99000000</color>

    <!-- Filter chips: selected = accent, unselected = quiet surface -->
    <color name="chip_selected_bg">#229ED9</color>
    <color name="chip_selected_text">#FFFFFF</color>
    <color name="chip_unselected_bg">#1B2740</color>
    <color name="chip_unselected_text">#C4D0E0</color>
    <color name="chip_unselected_stroke">#2E3D57</color>

    <!-- Skeleton shimmer base -->
    <color name="skeleton">#1B2740</color>

    <!-- v8: dark translucent pills (quality / duration / cached badges) -->
    <color name="badge_dark_bg">#CC000000</color>
    <!-- v8: bottom-nav selected indicator — accent at 20% alpha -->
    <color name="nav_indicator">#33229ED9</color>
</resources>
